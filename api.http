    "color": "Space Black",
    "storage": "256GB",
    "chip": "M4",
    "display_size": "13.00",
    "display_type": "Ultra Retina XDR OLED",
    "ram": "16GB",
    "has_cellular": false,
    "has_pencil": true,
    "pencil_gen": "Apple Pencil Pro",
    "battery_hours": 10
  }
}

