@baseUrl = http://127.0.0.1:8000/api/v1
@contentType = application/json

# ═══════════════════════════════════════════
# CATEGORIES
# ═══════════════════════════════════════════

### Список категорій
GET {{baseUrl}}/categories/

### Категорія по ID
GET {{baseUrl}}/categories/1/


# ═══════════════════════════════════════════
# PRODUCTS — GET
# ═══════════════════════════════════════════

### Всі товари
GET {{baseUrl}}/products/

### Товар по ID
GET {{baseUrl}}/products/iphone-16-pro-256gb-black-titanium

### Фільтр по категорії — iPhone
GET {{baseUrl}}/products/?category=iphone

### Фільтр по категорії — MacBook
GET {{baseUrl}}/products/?category=macbook

### Фільтр по категорії — iPad
GET {{baseUrl}}/products/?category=ipad

### Фільтр по категорії — iMac
GET {{baseUrl}}/products/?category=imac

### Фільтр по категорії — Apple Watch
GET {{baseUrl}}/products/?category=watch

### Фільтр по категорії — AirPods
GET {{baseUrl}}/products/?category=airpods

### Фільтр по категорії — Keyboard
GET {{baseUrl}}/products/?category=keyboard

### Фільтр по категорії — Mouse
GET {{baseUrl}}/products/?category=mouse

### Пошук по назві
GET {{baseUrl}}/products/?search=iPhone

### Сортування по ціні (зростання)
GET {{baseUrl}}/products/?ordering=price

### Сортування по ціні (спадання)
GET {{baseUrl}}/products/?ordering=-price

### Комбінований фільтр
GET {{baseUrl}}/products/?category__slug=iphone&ordering=-price&search=Pro


# ═══════════════════════════════════════════
# PRODUCTS — POST
# ═══════════════════════════════════════════

### Створити iPhone
POST {{baseUrl}}/products/
Content-Type: {{contentType}}

{
  "category": "iphone",
  "name": "iPhone 16 Pro 256GB Black Titanium",
  "sku": "IPH-16PRO-256-BLK",
  "price": "54999.00",
  "old_price": "59999.00",
  "stock": 10,
  "description": "iPhone 16 Pro з чіпом A18 Pro",
  "specs": {
    "model_name": "iPhone 16 Pro",
    "color": "Black Titanium",
    "storage": "256GB",
    "chip": "A18 Pro",
    "display_size": "6.30",
    "display_type": "Super Retina XDR OLED",
    "ram": "8GB",
    "main_camera": "48 MP Triple",
    "front_camera": "12 MP",
    "battery_mah": 3582,
    "has_5g": true,
    "has_esim": true
  }
}

###

### Створити iPad
POST {{baseUrl}}/products/
Content-Type: {{contentType}}

{
  "category": "ipad",
  "name": "iPad Pro 13 M4 256GB Space Black",
  "sku": "IPAD-PRO13-M4-256-SB",
  "price": "49999.00",
